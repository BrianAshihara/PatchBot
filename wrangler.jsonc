{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patch-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/2 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patch-bot",
      "database_id": "e59354ad-d753-41c8-a0dc-554c4397ed1b",
      "migrations_dir": "migrations"
    }
  ]
}
